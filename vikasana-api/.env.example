# ─────────────────────────────────────────────────────────
# Vikasana Foundation API — Environment Configuration
# Copy to .env for local development
# Do NOT put real production secrets in this file
# ─────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────
# PostgreSQL
# Local Docker Compose exposes PostgreSQL on host port 5433
# ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://admin:StrongPass123@127.0.0.1:5433/appdb
DATABASE_SYNC_URL=postgresql://admin:StrongPass123@127.0.0.1:5433/appdb

# Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ─────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ─────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────
SECRET_KEY=replace_me_with_secure_token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,https://vikasana-admin.vercel.app

# ─────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
PUBLIC_BASE_URL=https://yourdomain.com

# ─────────────────────────────────────────────────────────
# Certificate QR Verification
# ─────────────────────────────────────────────────────────
CERT_SIGNING_SECRET=replace_me
CERT_TEMPLATE_PDF_PATH=/app/app/assets/certificate_template.pdf

# ─────────────────────────────────────────────────────────
# Storage Provider
# minio = Hostinger/local MinIO
# aws   = AWS S3
# ─────────────────────────────────────────────────────────
S3_PROVIDER=minio

# ─────────────────────────────────────────────────────────
# MinIO / S3-compatible storage
# Used when S3_PROVIDER=minio
# ─────────────────────────────────────────────────────────
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace_me
MINIO_SECRET_KEY=replace_me
MINIO_SECURE=false

# Public MinIO URL
MINIO_PUBLIC_ENDPOINT=minio.yourdomain.com
MINIO_PUBLIC_SECURE=true
MINIO_PUBLIC_BASE=https://minio.yourdomain.com

# MinIO Bucket Names
MINIO_BUCKET_FACULTY=vikasana-faculty
MINIO_BUCKET_ACTIVITIES=activity-uploads
MINIO_BUCKET_EVENT_THUMBNAILS=vikasana-event-thumbnails
MINIO_FACE_BUCKET=face-verification
MINIO_BUCKET_CERTIFICATES=vikasana-certificates

# ─────────────────────────────────────────────────────────
# AWS S3
# Used when S3_PROVIDER=aws
# For AWS Fargate production, prefer IAM Role instead of access keys.
# ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_S3_ENDPOINT=s3.ap-south-1.amazonaws.com

AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

AWS_S3_BUCKET_FACULTY=vikasana-faculty
AWS_S3_BUCKET_ACTIVITIES=activity-uploads
AWS_S3_BUCKET_EVENT_THUMBNAILS=vikasana-event-thumbnails
AWS_S3_BUCKET_FACE=face-verification
AWS_S3_BUCKET_CERTIFICATES=vikasana-certificates

# ─────────────────────────────────────────────────────────
# Email - Brevo / Sendinblue
# ─────────────────────────────────────────────────────────
SENDINBLUE_API_KEY=replace_me
EMAIL_FROM=noreply@vikasanafoundation.org
EMAIL_FROM_NAME=Vikasana Foundation

# ─────────────────────────────────────────────────────────
# Faculty Activation
# ─────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:5173
ACTIVATION_TOKEN_SECRET=replace_me
ACTIVATION_TOKEN_EXPIRE_HOURS=48

# ─────────────────────────────────────────────────────────
# Celery
# ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ─────────────────────────────────────────────────────────
# Local Docker Compose PostgreSQL Container
# Used by docker-compose.yml
# ─────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=StrongPass123
POSTGRES_DB=appdb

# ─────────────────────────────────────────────────────────
# Local Docker Compose MinIO Container
# Used by docker-compose.yml
# ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=replace_me
MINIO_ROOT_PASSWORD=replace_me